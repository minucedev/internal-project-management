{
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.project.sourcePaths": ["backend/crm_mini/src/main/java", "backend/crm_mini/src/test/java"],
    "java.project.outputPath": "backend/crm_mini/target/classes",
    "java.import.gradle.enabled": false,
    "java.import.maven.enabled": true,
    "maven.terminal.useJavaHome": true,
    "maven.terminal.customEnv": [
        {
            "environmentVariable": "JAVA_HOME",
            "value": "C:\\Program Files\\Java\\jdk-21"  // Update this with your JDK 21 path
        }
    ]
}